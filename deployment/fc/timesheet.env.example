# Set these in Alibaba FC environment variables, never in public/ or Git.
TIMESHEET_API_URL=
TIMESHEET_API_TOKEN=
TIMESHEET_AUTH_MODE=bearer
# Confirm with Softtek: filled, submitted, or approved. No silent default.
TIMESHEET_STATUS_BASIS=
TIMESHEET_POLL_SECONDS=300
TIMESHEET_TIMEOUT_SECONDS=10
# Stable employee ID / lowercase email -> existing Resource List key.
# Example shape only: {"employee-id-from-softtek":"nick_han"}
TIMESHEET_RESOURCE_MAP={}